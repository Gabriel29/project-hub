# Set these privately in Dokploy Environment; retain existing production values.
POSTGRES_PASSWORD=replace-with-existing-production-password
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
# Required only until the first Owner is created.
BOOTSTRAP_TOKEN=

PUBLIC_ORIGIN=https://portal.example.com
PORTAL_ALLOWED_HOSTS=portal.example.com;localhost
# Set these to the actual Dokploy routing proxy IP/CIDR, not all networks.
TRUSTED_PROXIES=
TRUSTED_PROXY_NETWORKS=

# Timeout for each queued storage deletion attempt, in minutes.
STORAGE_DELETION_TIMEOUT_MINUTES=90
